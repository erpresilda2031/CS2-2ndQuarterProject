import datetime

def student_login():

# Handles w/ the users name
    fname = input("\nFirst Name: ")
    lname = input("Last Name: ")
    name = print("\nName:", fname.strip().title(), lname.strip().title())

# Handles w/ date & time    
    date = print("Date:", datetime.datetime.now().strftime("%B %-d, %Y"))
    now = datetime.datetime.now()
    time = now.time()
    deadline = datetime.time(7, 3, 0)
    start = datetime.time(5, 0, 0)

# Checks if the user is early, on time, or tardy   
    if time <= deadline:
        print("Status: On Time, welcome!")
    elif time < start:
        print("Status: Too Early, please come again later.")
    else:
        print("Status: Tardy, please get an admission slip.")

print("----- STUDENT LOG-IN PROGRAM -----")


student_login()
